      target_content: "@Composable\nfun HistoricRunRowItem(run: DailyRunEntity, habits: List<HabitEntity>) {\n    var expanded by remember { mutableStateOf(false) }\n \n    val completedCount = remember(run) {\n        run.completedHabitIdsCsv.split(\",\").filter { it.isNotEmpty() }.size\n    }\n \n    val conqueredWorriesList = remember(run) {\n        run.sufferingConqueredRaw.split(\",\").filter { it.isNotEmpty() }\n    }\n \n    val moodLabel = when (run.moodReported) {\n        1 -> \"(: GREAT\"\n        0 -> \"([M] MEH)\"\n        -1 -> \"): HARD\"\n        else -> \"NO CHECKIN\"\n    }\n \n    val moodColor = when (run.moodReported) {\n        1 -> NES_GREEN_LIGHT\n        0 -> NES_GREY\n        -1 -> NES_RED\n        else -> Color.DarkGray\n    }\n \n    Box(\n        modifier = Modifier\n            .fillMaxWidth()\n            .border(width = 1.dp, color = NES_WHITE)\n            .background(if (expanded) Color(0xFF111111) else Color(0xFF000000))\n            .clickable { expanded = !expanded }\n            .padding(10.dp)\n    ) {\n        Column {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(verticalAlignment = Alignment.CenterVertically) {\n                    Text(\n                        text = if (expanded) \"v \" else \"> \",\n                        color = NES_GOLD,\n                        fontFamily = FontFamily.Monospace,\n                        fontWeight = FontWeight.Bold,\n                        fontSize = 12.sp\n                    )\n                    Text(\n                        text = \"RUN: ${run.date}\",\n                        color = NES_WHITE,\n                        fontFamily = FontFamily.Monospace,\n                        fontWeight = FontWeight.Bold,\n                        fontSize = 12.sp\n                    )\n                }\n \n                Row(verticalAlignment = Alignment.CenterVertically) {\n                    Text(\n                        text = moodLabel,\n                        color = moodColor,\n                        fontFamily = FontFamily.Monospace,\n                        fontWeight = FontWeight.Bold,\n                        fontSize = 11.sp,\n                        modifier = Modifier.padding(end = 6.dp)\n                    )\n \n                    Box(\n                        modifier = Modifier\n                            .background(Color(0xFF003800))\n                            .padding(horizontal = 6.dp, vertical = 2.dp)\n                    ) {\n                        Text(\n                            text = \"BUFFS: $completedCount\",\n                            color = NES_GREEN_LIGHT,\n                            fontFamily = FontFamily.Monospace,\n                            fontSize = 9.sp,\n                            fontWeight = FontWeight.Bold\n                        )\n                    }\n                }\n            }\n \n            if (expanded) {\n                Spacer(modifier = Modifier.height(8.dp))\n                Box(modifier = Modifier.fillMaxWidth().height(1.dp).background(NES_GREY))\n                Spacer(modifier = Modifier.height(6.dp))\n \n                // Detail section\n                Text(\n                    text = \"COMPLETED BUFFS:\",\n                    color = NES_GREEN_LIGHT,\n                    fontFamily = FontFamily.Monospace,\n                    fontSize = 10.sp,\n                    fontWeight = FontWeight.Bold\n                )\n \n                val completedIdsSet = run.completedHabitIdsCsv.split(\",\").toSet()\n                val completedHabitsNames = habits.filter { completedIdsSet.contains(it.id) }.map { it.name }\n \n                if (completedHabitsNames.isEmpty()) {\n                    Text(\n                        text = \"- None\",\n                        color = NES_GREY,\n                        fontFamily = FontFamily.Monospace,\n                        fontSize = 10.sp\n                    )\n                } else {\n                    completedHabitsNames.forEach { name ->\n                        Text(\n                            text = \"- $name \342\234\224\",\n                            color = NES_WHITE,\n                            fontFamily = FontFamily.Monospace,\n                            fontSize = 10.sp\n                        )\n                    }\n                }\n \n                Spacer(modifier = Modifier.height(6.dp))\n \n                Text(\n                    text = \"CONQUERED WORRIES:\",\n                    color = NES_RED,\n                    fontFamily = FontFamily.Monospace,\n                    fontSize = 10.sp,\n                    fontWeight = FontWeight.Bold\n                )\n \n                if (conqueredWorriesList.isEmpty()) {\n                    Text(\n                        text = \"- None\",\n                        color = NES_GREY,\n                        fontFamily = FontFamily.Monospace,\n                        fontSize = 10.sp\n                    )\n                } else {\n                    conqueredWorriesList.forEach { name ->\n                        Text(\n                            text = \"- Swatted down \\\"$name\\\" \342\232\224\",\n                            color = NES_WHITE,\n                            fontFamily = FontFamily.Monospace,\n                            fontSize = 10.sp\n                        )\n                    }\n                }\n            }\n        }\n    }\n}"
      replacement_content: "@Composable\nfun HistoricRunRowItem(\n    viewModel: MainViewModel,\n    run: DailyRunEntity,\n    habits: List<HabitEntity>,\n    runsList: List<DailyRunEntity>\n) {\n    var expanded by remember { mutableStateOf(false) }\n    var showCustomizer by remember { mutableStateOf(false) }\n\n    val completedCount = remember(run) {\n        val splitList = run.completedHabitIdsCsv.split(\",\").filter { it.isNotEmpty() }\n        splitList.size\n    }\n\n    val conqueredWorriesList = remember(run) {\n        run.sufferingConqueredRaw.split(\",\").filter { it.isNotEmpty() }\n    }\n\n    val moodLabel = when (run.moodReported) {\n        1 -> \"(: GREAT\"\n        0 -> \"([M] MEH)\"\n        -1 -> \"): HARD\"\n        else -> \"NO CHECKIN\"\n    }\n\n    val moodColor = when (run.moodReported) {\n        1 -> NES_GREEN_LIGHT\n        0 -> NES_GREY\n        -1 -> NES_RED\n        else -> Color.DarkGray\n    }\n\n    Box(\n        modifier = Modifier\n            .fillMaxWidth()\n            .border(width = 1.dp, color = NES_WHITE)\n            .background(if (expanded) Color(0xFF111111) else Color(0xFF000000))\n            .clickable { expanded = !expanded }\n            .padding(10.dp)\n    ) {\n        Column {\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween,\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Row(verticalAlignment = Alignment.CenterVertically) {\n                    Text(\n                        text = if (expanded) \"v \" else \"> \",\n                        color = NES_GOLD,\n                        fontFamily = FontFamily.Monospace,\n                        fontWeight = FontWeight.Bold,\n                        fontSize = 12.sp\n                    )\n                    Text(\n                        text = \"RUN: ${run.date}\",\n                        color = NES_WHITE,\n                        fontFamily = FontFamily.Monospace,\n                        fontWeight = FontWeight.Bold,\n                        fontSize = 12.sp\n                    )\n                }\n\n                Row(verticalAlignment = Alignment.CenterVertically) {\n                    Text(\n                        text = moodLabel,\n                        color = moodColor,\n                        fontFamily = FontFamily.Monospace,\n                        fontWeight = FontWeight.Bold,\n                        fontSize = 11.sp,\n                        modifier = Modifier.padding(end = 6.dp)\n                    )\n\n                    Box(\n                        modifier = Modifier\n                            .background(Color(0xFF003800))\n                            .padding(horizontal = 6.dp, vertical = 2.dp)\n                    ) {\n                        Text(\n                            text = \"BUFFS: $completedCount\",\n                            color = NES_GREEN_LIGHT,\n                            fontFamily = FontFamily.Monospace,\n                            fontSize = 9.sp,\n                            fontWeight = FontWeight.Bold\n                        )\n                    }\n                }\n            }\n\n            if (expanded) {\n                Spacer(modifier = Modifier.height(8.dp))\n                Box(modifier = Modifier.fillMaxWidth().height(1.dp).background(NES_GREY))\n                Spacer(modifier = Modifier.height(6.dp))\n\n                // Detail section\n                Text(\n                    text = \"COMPLETED BUFFS (ORDER COMPLETED):\",\n                    color = NES_GREEN_LIGHT,\n                    fontFamily = FontFamily.Monospace,\n                    fontSize = 10.sp,\n                    fontWeight = FontWeight.Bold\n                )\n\n                val completedIds = run.completedHabitIdsCsv.split(\",\").filter { it.isNotEmpty() }\n\n                if (completedIds.isEmpty()) {\n                    Text(\n                        text = \"- None\",\n                        color = NES_GREY,\n                        fontFamily = FontFamily.Monospace,\n                        fontSize = 10.sp\n                    )\n                } else {\n                    completedIds.forEachIndexed { index, id ->\n                        val h = habits.find { it.id == id }\n                        val nameStr = h?.name ?: \"Habit ($id)\"\n                        Text(\n                            text = \"- Step #${index + 1}: $nameStr \342\234\224\",\n                            color = NES_WHITE,\n                            fontFamily = FontFamily.Monospace,\n                            fontSize = 10.sp\n                        )\n                    }\n                }\n\n                Spacer(modifier = Modifier.height(6.dp))\n\n                Text(\n                    text = \"CONQUERED WORRIES:\",\n                    color = NES_RED,\n                    fontFamily = FontFamily.Monospace,\n                    fontSize = 10.sp,\n                    fontWeight = FontWeight.Bold\n                )\n\n                if (conqueredWorriesList.isEmpty()) {\n                    Text(\n                        text = \"- None\",\n                        color = NES_GREY,\n                        fontFamily = FontFamily.Monospace,\n                        fontSize = 10.sp\n                    )\n                } else {\n                    conqueredWorriesList.forEach { name ->\n                        Text(\n                            text = \"- Swatted down \\\"$name\\\" \342\232\224\",\n                            color = NES_WHITE,\n                            fontFamily = FontFamily.Monospace,\n                            fontSize = 10.sp\n                        )\n                    }\n                }\n\n                if (run.notableEvents.isNotEmpty()) {\n                    Spacer(modifier = Modifier.height(6.dp))\n                    Text(\n                        text = \"MEMORABLE EVENTS / FACTORS:\",\n                        color = NES_GOLD,\n                        fontFamily = FontFamily.Monospace,\n                        fontSize = 10.sp,\n                        fontWeight = FontWeight.Bold\n                    )\n                    Text(\n                        text = run.notableEvents,\n                        color = NES_PEACH,\n                        fontFamily = FontFamily.Monospace,\n                        fontSize = 10.sp\n                    )\n                }\n\n                // Edit Button\n                Spacer(modifier = Modifier.height(10.dp))\n                Button(\n                    onClick = { showCustomizer = true },\n                    colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF1E1E1E)),\n                    modifier = Modifier.fillMaxWidth().border(1.dp, NES_GOLD),\n                    contentPadding = PaddingValues(0.dp)\n                ) {\n                    Text(\n                        text = \"\360\237\223\235 CUSTOMIZE BUFF ORDER & MOOD/EVENTS\",\n                        color = NES_GOLD,\n                        fontFamily = FontFamily.Monospace,\n                        fontSize = 10.sp,\n                        fontWeight = FontWeight.Bold\n                    )\n                }\n            }\n        }\n    }\n\n    if (showCustomizer) {\n        Dialog(onDismissRequest = { showCustomizer = false }) {\n            Box(\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .fillMaxHeight(0.9f)\n            ) {\n                RunSummaryEditorPanel(\n                    viewModel = viewModel,\n                    run = run,\n                    allHabits = habits,\n                    runsList = runsList,\n                    title = \"EDIT PAST RUN LOG\",\n                    onActionLabel = \"SAVE & CLOSE RECORD\",\n                    onAction = { showCustomizer = false }\n                )\n            }\n        }\n    }\n}"
    }
    instruction: "Replace HistoricRunRowItem with editable customized version"
  }
}
