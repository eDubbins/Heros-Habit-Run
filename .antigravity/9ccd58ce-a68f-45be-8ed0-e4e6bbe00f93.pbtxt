        lines {
          text: "                        )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        Spacer(modifier = Modifier.height(2.dp))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
