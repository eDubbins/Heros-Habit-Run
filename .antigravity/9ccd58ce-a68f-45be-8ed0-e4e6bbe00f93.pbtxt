        lines {
          text: "                horizontalArrangement = Arrangement.End"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
