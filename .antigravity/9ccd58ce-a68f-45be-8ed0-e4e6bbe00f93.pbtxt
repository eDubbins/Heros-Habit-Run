        lines {
          text: "                TextButton(onClick = onDismiss) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    Text(\"ABORT\", color = NES_GREY, fontFamily = FontFamily.Monospace)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
