    replacement_infos {
      original_chunk {
        target_content: "object ZeldaSprites {\n\n    // Helper map of chars to Colors\n    private val charColorMap = mapOf(\n        \' \' to NES_TRANSPARENT,\n        \'X\' to NES_TRANSPARENT,\n        \'K\' to NES_BLACK,\n        \'W\' to NES_WHITE,\n        \'R\' to NES_RED,\n        \'P\' to NES_PEACH,\n        \'G\' to NES_GREEN_LIGHT,\n        \'D\' to NES_GREEN_DARK,\n        \'Y\' to NES_GOLD,\n        \'U\' to NES_BLUE_DARK,\n        \'L\' to NES_BLUE_LIGHT,\n        \'B\' to NES_BROWN,\n        \'S\' to NES_GREY\n    )\n\n    fun parsePattern(pattern: List<String>): List<List<Color>> {\n        return pattern.map { row ->\n            row.map { char ->\n                charColorMap[char.uppercaseChar()] ?: NES_TRANSPARENT\n            }\n        }\n    }\n\n    val HERO = parsePattern(listOf(\n        \"    KKKKK    \",\n        \"   KGGGGGK   \",\n        \"  KGDDDGGGK  \",\n        \" KGPKKKPGPK  \",\n        \" KPPPPPPPPK  \",\n        \" KPKKKKKKPK  \",\n        \" KPYWWWWYPK  \",\n        \"  KPPPPPK    \",\n        \"  KGGGGGK    \",\n        \" KGGKGGKGGK  \",\n        \"KGGKGGGGKGGK \",\n        \"KKKKGGGGKKKK \",\n        \"  KBBKKBBK   \",\n        \"  KKB  BKK   \",\n        \"   KK  KK    \"\n    ))"
        replacement_content: "object ZeldaSprites {\n\n    // Helper map of chars to Colors\n    private val charColorMap = mapOf(\n        \' \' to NES_TRANSPARENT,\n        \'X\' to NES_TRANSPARENT,\n        \'K\' to NES_BLACK,\n        \'W\' to NES_WHITE,\n        \'R\' to NES_RED,\n        \'P\' to NES_PEACH,\n        \'G\' to NES_GREEN_LIGHT,\n        \'D\' to NES_GREEN_DARK,\n        \'Y\' to NES_GOLD,\n        \'U\' to NES_BLUE_DARK,\n        \'L\' to NES_BLUE_LIGHT,\n        \'B\' to NES_BROWN,\n        \'S\' to NES_GREY\n    )\n\n    fun parsePattern(pattern: List<String>): List<List<Color>> {\n        return pattern.map { row ->\n            row.map { char ->\n                charColorMap[char.uppercaseChar()] ?: NES_TRANSPARENT\n            }\n        }\n    }\n\n    val SAGE_TEMPLATE = listOf(\n        \"    KKKKK    \",\n        \"   KGGGGGK   \",\n        \"  KGDWWDGGK  \",\n        \" KGDWWKWWDKK \",\n        \" KDWWKPKWDK  \",\n        \" KDKKPPPKKDK \",\n        \" KDKPPPPKDK  \",\n        \"  KWWWWWWK   \",\n        \"  KGGGGGGK   \",\n        \" KGGYDDDYGGK \",\n        \"KGGYGGGGYGGK \",\n        \"KKGGGGGGGGKK \",\n        \"  KDDDKDDDK  \",\n        \"  KDD   DDK  \",\n        \"   KK   KK   \"\n    )\n\n    val KNIGHT_TEMPLATE = listOf(\n        \"    KKKKK    \",\n        \"   KGGGGGK   \",\n        \"  KGDYDYDGK  \",\n        \" KGDKKKKKDGK \",\n        \" KDKKKKKKKDK \",\n        \" KDKYWWWYKDK \",\n        \" KDKKKKKKKDK \",\n        \"  KGGGGGGK   \",\n        \"  KGGGGGGK   \",\n        \" KGGYGGGYGGK \",\n        \"KGGGGGGGGGGK \",\n        \"KKKGGGGGGKKK \",\n        \"  KDDDKDDDK  \",\n        \"  KKD   DKK  \",\n        \"   KK   KK   \"\n    )\n\n    val FAIRY_TEMPLATE = listOf(\n        \"   YKKKKKY   \",\n        \"  YYKGGGYKK  \",\n        \" YWWKPKWKKK  \",\n        \"  YWKPPPWK   \",\n        \"   KPPPKK    \",\n        \"  KKKPKKK    \",\n        \" KGGGGGGGK   \",\n        \"KGGGGGGGGGK  \",\n        \" KKGDYDGKK   \",\n        \"  KGGYGGK    \",\n        \"  KDDYDDK    \",\n        \"  KDK KK     \",\n        \"  KK  KK     \"\n    )\n\n    val HERO_TEMPLATE = listOf(\n        \"    KKKKK    \",\n        \"   KGGGGGK   \",\n        \"  KGDDDGGGK  \",\n        \" KGPKKKPGPK  \",\n        \" KPPPPPPPPK  \",\n        \" KPKKKKKKPK  \",\n        \" KPYWWWWYPK  \",\n        \"  KPPPPPK    \",\n        \"  KGGGGGK    \",\n        \" KGGKGGKGGK  \",\n        \"KGGKGGGGKGGK \",\n        \"KKKKGGGGKKKK \",\n        \"  KBBKKBBK   \",\n        \"  KKB  BKK   \",\n        \"   KK  KK    \"\n    )\n\n    fun getCustomHeroSprite(\n        spriteType: String,\n        primaryColorName: String,\n        secondaryColorName: String,\n        accessoryColorName: String\n    ): List<List<Color>> {\n        val pattern = when (spriteType.lowercase()) {\n            \"sage\" -> SAGE_TEMPLATE\n            \"knight\" -> KNIGHT_TEMPLATE\n            \"fairy\" -> FAIRY_TEMPLATE\n            else -> HERO_TEMPLATE\n        }\n\n        val primary = when (primaryColorName.lowercase()) {\n            \"green\" -> NES_GREEN_LIGHT\n            \"red\" -> NES_RED\n            \"blue\" -> NES_BLUE_LIGHT\n            \"gold\" -> NES_GOLD\n            \"white\" -> NES_WHITE\n            else -> NES_GREEN_LIGHT\n        }\n\n        val secondary = when (secondaryColorName.lowercase()) {\n            \"dark_green\" -> NES_GREEN_DARK\n            \"dark_red\" -> Color(0xFF801800)\n            \"dark_blue\" -> NES_BLUE_DARK\n            \"brown\" -> NES_BROWN\n            \"grey\" -> NES_GREY\n            else -> NES_GREEN_DARK\n        }\n\n        val accessory = when (accessoryColorName.lowercase()) {\n            \"gold\" -> NES_GOLD\n            \"white\" -> NES_WHITE\n            \"peach\" -> NES_PEACH\n            \"pink\" -> Color(0xFFFC80A0)\n            else -> NES_GOLD\n        }\n\n        return pattern.map { row ->\n            row.map { char ->\n                when (char.uppercaseChar()) {\n                    \' \' -> NES_TRANSPARENT\n                    \'X\' -> NES_TRANSPARENT\n                    \'K\' -> NES_BLACK\n                    \'W\' -> NES_WHITE\n                    \'R\' -> NES_RED\n                    \'P\' -> NES_PEACH\n                    \'G\' -> primary\n                    \'D\' -> secondary\n                    \'Y\' -> accessory\n                    \'U\' -> NES_BLUE_DARK\n                    \'L\' -> NES_BLUE_LIGHT\n                    \'B\' -> NES_BROWN\n                    \'S\' -> NES_GREY\n                    else -> NES_TRANSPARENT\n                }\n            }\n        }\n    }\n\n    val HERO = parsePattern(HERO_TEMPLATE)"
      }
