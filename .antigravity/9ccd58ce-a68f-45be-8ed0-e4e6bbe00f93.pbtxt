        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val previewSprite = remember(selectedSpriteType, selectedPrimaryColor, selectedSecondaryColor, selectedAccessoryColor) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
