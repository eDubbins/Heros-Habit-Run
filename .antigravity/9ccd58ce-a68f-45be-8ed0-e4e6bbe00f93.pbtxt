          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                modifier = Modifier.fillMaxWidth(),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
