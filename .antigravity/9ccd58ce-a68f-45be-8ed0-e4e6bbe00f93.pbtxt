          text: "                    topLeft = Offset(strokeWidth / 2, strokeWidth / 2),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    size = Size(size.width - strokeWidth, size.height - strokeWidth),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    style = Stroke(width = strokeWidth)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
