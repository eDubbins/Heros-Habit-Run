        lines {
          text: "        Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (bestHabit != null) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
