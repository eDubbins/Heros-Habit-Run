        lines {
          text: "                Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    text = \"* Completing \'${bestHabit.first.name}\' positively influences your next day (+${bestHabit.second.toInt() * 10}% correlation). Maintain this Power-Up!\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    color = NES_WHITE,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    fontFamily = FontFamily.Monospace,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    fontSize = 10.sp"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
